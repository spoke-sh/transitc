{
  "version": 1,
  "boundaries": [
    {
      "id": "application-source",
      "profile": "Pure application source compilation and offline CLI capture, resolution and artifact publication; imported owner failures retain context at their boundary",
      "owners": [
        "packages/transitc-compiler/src/*.zig",
        "packages/transitc-workspace/src/BuildSources.zig",
        "packages/transitc-workspace/src/Build.zig",
        "packages/transitc-workspace/src/BuildMigration.zig"
      ],
      "exclude": [
        "packages/transitc-compiler/src/SourceDiagnostic.zig"
      ],
      "registry": "packages/transitc-compiler/src/SourceDiagnostic.zig",
      "registry_kind": "source_family",
      "projection": "packages/transitc-compiler/src/SourceDiagnostic.zig",
      "shared_codes": true,
      "stage": "input, parse, bind, compile or output, retained from the failing owner",
      "outcome": "not_submitted",
      "durable_evidence": "No SQL is dispatched during compilation, fetching or build artifact publication; test execution has a separate report.",
      "context": "Captured path and kind, operation, target/dependency/column names, source origins and related calls, expected/actual source types and known budgets",
      "disclosure": "Bounded names, types and escaped path bytes; no source excerpts, operand values, repository credentials or fetched bodies",
      "recovery": "Family-specific correction, explicit dependency fetch/review or fresh output directory; never replay accepted SQL",
      "propagation": "Unknown imported I/O/allocation failures retain their original native cause and best known context. Input/cache/output owners specialize the family and stage before unwinding. Runtime test failures do not use this boundary.",
      "tests": [
        {
          "source": "packages/transitc-compiler/src/SourceDiagnostic.zig",
          "name": "source failures retain actionable families and escaped paths without invented locations"
        },
        {
          "source": "packages/transitc-compiler/src/SourceDiagnostic.zig",
          "name": "source diagnostic families validate within the shared envelope bounds"
        },
        {
          "source": "packages/transitc-compiler/src/tests.zig",
          "name": "unselected recursive checking validates bodies and preserves call diagnostics"
        },
        {
          "source": "packages/transitc-workspace/src/EnvelopeDiagnostic.zig",
          "name": "source diagnostics show primary and related filenames with safe terminal text"
        },
        {
          "source": "packages/transitc-compiler/src/resource_test.zig",
          "name": "nominal log checks cover literal names identifier holes metadata and omitted fields"
        },
        {
          "source": "packages/transitc-compiler/src/migration_test.zig",
          "name": "migration basis rejects changed history foreign definitions duplicates and stale versions"
        },
        {
          "source": "packages/transitc-compiler/src/program_test.zig",
          "name": "returning procedures refuse missing early void mismatched and escaping results"
        }
      ],
