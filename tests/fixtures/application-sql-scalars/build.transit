CREATE MODULE Exact(large NUMERIC(38,9), minimum NUMERIC(38,9)) AS BEGIN
  CREATE PUBLIC TABLE exact_values (id BIGINT PRIMARY KEY, amount NUMERIC(38, 9), payload JSON, span INTERVAL);
  INSERT INTO exact_values VALUES
    (1, $large, JSON '{"large":9007199254740993,"fraction":1.25,"value":null}', INTERVAL(1, -2, 3)),
    (2, $minimum, JSON 'null', INTERVAL(-2147483648, 2147483647, -9223372036854775808)),
    (3, NULL, NULL, NULL);
END;
CREATE MODULE Setup() AS BEGIN
  USE Exact(NUMERIC(38,9) '9007199254740993.123456789', NUMERIC(38,9) '-99999999999999999999999999999.999999999');
END;
CREATE TARGET default AS BEGIN USE Setup(); END;
CREATE TEST TARGET tests AS BEGIN
  TEST 'exact decimal JSON and interval components' USING MODULES (Setup()) AS BEGIN
    ASSERT ROWS (SELECT id, amount, payload, span FROM exact_values) EQUAL (
      (1, 9007199254740993.123456789, JSON '{"large":9007199254740993,"fraction":1.25,"value":null}', INTERVAL(1, -2, 3)),
      (2, -99999999999999999999999999999.999999999, JSON 'null', INTERVAL(-2147483648, 2147483647, -9223372036854775808)),
      (3, NULL, NULL, NULL)
    );
  END;
END;
