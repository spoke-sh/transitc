CREATE PUBLIC PROCEDURE SelectBatch(t TABLE(id BIGINT PRIMARY KEY, note TEXT)) RETURNS MANY(2) ROW(id BIGINT NOT NULL, note TEXT) ORDER BY id
EFFECTS (READ t)
AS BEGIN ATOMIC
  LET batch MANY(2) = SELECT id, note FROM t ORDER BY id;
  RETURN batch;
END;

CREATE PUBLIC PROCEDURE Lookup(t TABLE(id BIGINT PRIMARY KEY, note TEXT), key BIGINT) RETURNS OPTIONAL ROW(id BIGINT NOT NULL, note TEXT)
EFFECTS (READ t)
AS BEGIN ATOMIC
  LET found OPTIONAL = SELECT id, note FROM t WHERE id = key;
  RETURN found;
END;

CREATE PUBLIC PROCEDURE Required(t TABLE(id BIGINT PRIMARY KEY, note TEXT), key BIGINT) RETURNS ONE ROW(id BIGINT NOT NULL, note TEXT)
EFFECTS (READ t)
AS BEGIN ATOMIC
  LET found ONE = SELECT id, note FROM t WHERE id = key;
  RETURN found;
END;

CREATE PUBLIC PROCEDURE RelayBatch(batch MANY(2) ROW(id BIGINT NOT NULL, note TEXT) ORDER BY id) RETURNS MANY(2) ROW(id BIGINT NOT NULL, note TEXT) ORDER BY id
EFFECTS ()
AS BEGIN ATOMIC
  RETURN batch;
END;

CREATE PUBLIC PROCEDURE Emit(batch MANY(2) ROW(id BIGINT NOT NULL, note TEXT) ORDER BY id, events STREAM(id BIGINT NOT NULL, note TEXT))
EFFECTS (PRODUCE events)
AS BEGIN ATOMIC
  FOR item IN batch DO
    PRODUCE INTO events VALUES (item.id, item.note);
  END FOR;
END;

CREATE PUBLIC PROCEDURE Compare(found ONE ROW(id BIGINT NOT NULL, note TEXT), candidate OPTIONAL ROW(id BIGINT NOT NULL, note TEXT))
EFFECTS ()
AS BEGIN ATOMIC
  REQUIRE candidate IS NOT NULL ELSE 'AbsentRow';
  REQUIRE found.id = candidate.id ELSE 'DifferentRow';
END;
