IMPORT rows FROM 'rows.transit';
CREATE DOMAIN MachineId AS BIGINT IDENTITY 'example.machine';
CREATE DOMAIN SiteId AS BIGINT IDENTITY 'example.site';
CREATE VARIANT Target AS (Machine(id MachineId), Site(id SiteId));
CREATE FUNCTION identity_machine(value MachineId) RETURNS MachineId AS BEGIN RETURN value; END;
CREATE FUNCTION accepts(value MachineId) RETURNS BOOLEAN AS BEGIN RETURN TRUE; END;
CREATE MODULE EmitMachine(value MachineId) AS BEGIN
  CREATE PUBLIC DATAFLOW machine_route FROM QUEUE requests AS request WHERE accepts($value) AS BEGIN
    BEGIN ATOMIC
      INSERT INTO machines VALUES (identity_machine($value)) ON CONFLICT (id) DO ASSERT SAME ROW;
    END;
  END;
  AUTHORIZE DATAFLOW machine_route AS ROLE CURRENT_ROLE;
  ACTIVATE DATAFLOW machine_route;
END;
CREATE GUARD Validate(entry ROW(id BIGINT), expected SiteId) AS BEGIN REQUIRE rows.positive(entry) ELSE 'BadInput'; REQUIRE expected = expected ELSE 'BadId'; END;
CREATE PROCEDURE Accept(entry ROW(id BIGINT), expected SiteId) AS BEGIN ATOMIC CHECK GUARD Validate(entry, expected); END;
CREATE MODULE EmitSite(value SiteId) AS BEGIN
  CREATE PUBLIC DATAFLOW site_route FROM QUEUE requests AS request AS BEGIN
    BEGIN ATOMIC
      LET whole = request; CALL Accept(whole, $value); INSERT INTO sites VALUES ($value) ON CONFLICT (id) DO ASSERT SAME ROW;
    END;
  END;
  AUTHORIZE DATAFLOW site_route AS ROLE CURRENT_ROLE;
  ACTIVATE DATAFLOW site_route;
END;
CREATE MODULE Setup(machine TYPE, site TYPE, selected Target) AS BEGIN
  CREATE PUBLIC TABLE machines (id $machine PRIMARY KEY);
  CREATE PUBLIC TABLE sites (id $site PRIMARY KEY);
  CREATE PUBLIC QUEUE requests (id BIGINT NOT NULL, c1 BIGINT, c2 BIGINT, c3 BIGINT, c4 BIGINT, c5 BIGINT, c6 BIGINT, c7 BIGINT, c8 BIGINT, c9 BIGINT, c10 BIGINT, c11 BIGINT, c12 BIGINT, c13 BIGINT, c14 BIGINT, c15 BIGINT, c16 BIGINT, c17 BIGINT, c18 BIGINT, c19 BIGINT, c20 BIGINT, c21 BIGINT, c22 BIGINT, c23 BIGINT, c24 BIGINT, c25 BIGINT, c26 BIGINT, c27 BIGINT, c28 BIGINT, c29 BIGINT, c30 BIGINT, c31 BIGINT, c32 BIGINT, c33 BIGINT, c34 BIGINT, c35 BIGINT, c36 BIGINT, c37 BIGINT, c38 BIGINT, c39 BIGINT, c40 BIGINT, c41 BIGINT, c42 BIGINT, c43 BIGINT, c44 BIGINT, c45 BIGINT, c46 BIGINT, c47 BIGINT, c48 BIGINT, c49 BIGINT, c50 BIGINT, c51 BIGINT, c52 BIGINT, c53 BIGINT, c54 BIGINT, c55 BIGINT, c56 BIGINT, c57 BIGINT, c58 BIGINT, c59 BIGINT, c60 BIGINT, c61 BIGINT, c62 BIGINT, c63 BIGINT);
  MATCH selected
    WHEN Target.Machine(value) THEN USE EmitMachine(value);
    WHEN Target.Site(value) THEN USE EmitSite(value);
  END MATCH;
END;
CREATE TARGET default AS BEGIN USE Setup(TYPE MachineId, TYPE SiteId, Target.Site(SiteId(7))); END;

CREATE TEST TARGET tests AS BEGIN
  TEST 'whole input accepted' USING MODULES (Setup(TYPE MachineId, TYPE SiteId, Target.Site(SiteId(7)))) AS BEGIN
    ENQUEUE INTO requests VALUES (1, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
    ASSERT WORKFLOW NAME 'site_route' COMPLETED 1 REFUSED 0 WITHIN 1000 OBSERVATIONS;
    ASSERT ROWS (SELECT * FROM sites) EQUAL ((7));
  END;
  TEST 'whole input guard refusal' USING MODULES (Setup(TYPE MachineId, TYPE SiteId, Target.Site(SiteId(7)))) AS BEGIN
    ENQUEUE INTO requests VALUES (-1, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
    ASSERT WORKFLOW NAME 'site_route' COMPLETED 0 REFUSED 1 WITHIN 1000 OBSERVATIONS;
    ASSERT ROWS (SELECT * FROM sites) EQUAL ();
  END;
  TEST 'other specialization' USING MODULES (Setup(TYPE MachineId, TYPE SiteId, Target.Machine(MachineId(7)))) AS BEGIN
    ENQUEUE INTO requests VALUES (1, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
    ASSERT WORKFLOW NAME 'machine_route' COMPLETED 1 REFUSED 0 WITHIN 1000 OBSERVATIONS;
    ASSERT ROWS (SELECT * FROM machines) EQUAL ((7));
  END;
END;
