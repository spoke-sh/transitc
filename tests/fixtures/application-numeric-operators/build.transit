CREATE MODULE Setup() AS BEGIN
  CREATE PUBLIC TABLE numbers(id BIGINT PRIMARY KEY, amount NUMERIC(20,3));
  INSERT INTO numbers VALUES(1,9007199254740.125),(2,NULL);
END;
CREATE TARGET default AS BEGIN
  USE Setup();
  SELECT DECIMAL_ADD(amount,amount,20,3,REJECT) AS doubled FROM numbers;
  SELECT DECIMAL_RESCALE(amount,20,2,HALF_EVEN) AS rounded FROM numbers;
END;
CREATE TEST TARGET tests AS BEGIN
  TEST 'exact operations' USING MODULES(Setup()) AS BEGIN
    ASSERT ROWS(SELECT DECIMAL_ADD(amount,amount,20,3,REJECT) AS doubled FROM numbers) EQUAL ((18014398509480.250),(NULL));
    ASSERT ROWS(SELECT DECIMAL_RESCALE(amount,20,2,HALF_EVEN) AS rounded FROM numbers) EQUAL ((9007199254740.12),(NULL));
  END;
END;
