{
  "name": "transitc",
  "private": true,
  "workspaces": [
    "docs/handbook"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "tinypool": "2.1.2",
    "serialize-javascript": "7.1.3",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "playwright-core": "1.63.0"
  },
  "scripts": {
    "docs:dev": "npm run start --workspace @transitc/handbook",
    "docs:build": "npm run build --workspace @transitc/handbook",
    "docs:serve": "npm run serve --workspace @transitc/handbook",
    "docs:check": "npm run typecheck --workspace @transitc/handbook && npm run docs:build"
  }
}
